+ABBREVIATION_FIX_SYSTEM_PROMPT = """\
+Тебе дают уже готовый русский текст (заголовок + комментарий) для \
+телеграм-канала про экономику и список сокращений, которые в нём нашлись, с \
+их правильными русскими соответствиями. Перепиши текст, заменив ТОЛЬКО эти \
+сокращения на данные соответствия — согласуй падеж и число с окружающим \
+текстом (например, "по данным BofA" → "по данным Банка Америки", а не "по \
+данным Банк Америки"). Больше ничего не меняй: ни порядок слов, ни \
+остальную лексику, ни пунктуацию, ни цифры, ни названия компаний, которых в \
+списке сокращений нет. Если из-за замены фраза целиком перестаёт звучать \
+естественно — переформулируй минимально вокруг самой замены, но само \
+сокращение оставлять как есть нельзя ни в каком случае.
+
+Ответь СТРОГО в формате JSON — и ничего, кроме этого JSON-объекта:
+{"headline_ru": "...", "comment_ru": "..."}"""
+
+
+def fix_abbreviations(headline_ru: str, comment_ru: str, found: dict) -> tuple[str, str] | None:
+    """Точечная правка уже переведённого текста — вызывается ТОЛЬКО когда
+    find_known_abbreviations() уже нашла совпадение (found — непустой словарь
+    {сокращение: полное_имя}, см. main.py). Не решает сама, что искать —
+    отдельным узким запросом просит модель заменить конкретно эти найденные
+    сокращения с сохранением падежа, не трогая остальной текст.
+
+    Возвращает (headline_ru, comment_ru) с исправлениями, либо None при любом
+    сбое (сеть/формат ответа/пустой результат) — в этом случае main.py должен
+    публиковать ОРИГИНАЛЬНЫЙ текст как есть: пост с необъяснённым сокращением
+    хуже идеала, но лучше, чем пост, целиком потерянный из-за сбоя
+    необязательной правки."""
+    client = anthropic.Anthropic(api_key=config.ANTHROPIC_API_KEY, timeout=15.0)
+    glossary = "\n".join(f"- {abbr} → {full}" for abbr, full in found.items())
+    user_content = (
+        f"Заголовок: {headline_ru}\n"
+        f"Комментарий: {comment_ru}\n\n"
+        f"Сокращения для замены:\n{glossary}"
+    )
+
+    try:
+        response = client.messages.create(
+            model=config.LLM_MODEL,
+            max_tokens=400,
+            system=ABBREVIATION_FIX_SYSTEM_PROMPT,
+            messages=[{"role": "user", "content": user_content}],
+        )
+        raw = "".join(
+            block.text for block in response.content if getattr(block, "type", "") == "text"
+        ).strip()
+
+        if raw.startswith("```"):
+            raw = raw.strip("`")
+            raw = raw.split("\n", 1)[1] if "\n" in raw else raw
+            if raw.lower().startswith("json"):
+                raw = raw[4:]
+
+        data, _ = json.JSONDecoder().raw_decode(raw)
+        new_headline = data.get("headline_ru", "").strip()
+        new_comment = data.get("comment_ru", "").strip()
+        if not new_headline or not new_comment:
+            logger.warning("Правка сокращений вернула пустой текст (%r), оставляем оригинал", data)
+            return None
+        return new_headline, new_comment
+
+    except Exception as exc:
+        logger.error("Ошибка точечной правки сокращений %s: %s", list(found), exc)
+        return None
+
+
